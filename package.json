{
  "name": "youmightnotneed-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Find the modern CSS and HTML that replaces your JavaScript dependencies.",
  "license": "MIT",
  "author": "Johannes Maendle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jomaendle/youmightnotneed.git"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/**\" build",
    "build:web": "pnpm --filter @youmightnotneed/web build",
    "dev": "pnpm --filter @youmightnotneed/web dev",
    "test": "pnpm -r test",
    "typecheck": "tsc -p tsconfig.scripts.json && pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "refresh": "pnpm refresh:baseline && pnpm refresh:sizes",
    "refresh:baseline": "node scripts/refresh-baseline.ts",
    "refresh:sizes": "node scripts/refresh-sizes.ts",
    "check:freshness": "node scripts/check-freshness.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm knip && pnpm check:freshness && pnpm check:copy",
    "cli": "node packages/cli/src/bin.ts",
    "test:coverage": "pnpm -r test:coverage",
    "knip": "knip",
    "check:copy": "node scripts/check-copy.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^24.13.3",
    "knip": "^6.33.0",
    "typescript": "^7.0.2",
    "web-features": "^3.36.0"
  }
}
