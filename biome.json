{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.next",
      "!**/out",
      "!**/coverage",
      "!pnpm-lock.yaml",
      "!**/*.css",
      "!**/*.svg",
      "!packages/catalog/src/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "on",
      "complexity": "on",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "noProcessGlobal": "off",
        "noNodejsModules": "off",
        "noUnknownPseudoElement": "off",
        "noUnknownPseudoClass": "off"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noDelete": "error",
        "useTopLevelRegex": "warn",
        "noNamespaceImport": "off",
        "noBarrelFile": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "error",
        "noSecrets": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn", "info"]
          }
        },
        "noUnknownAtRules": "off"
      },
      "style": {
        "noNegationElse": "on",
        "noParameterAssign": "on",
        "noShoutyConstants": "off",
        "noUselessElse": "on",
        "useAtIndex": "on",
        "useCollapsedElseIf": "on",
        "useConst": "on",
        "useDefaultSwitchClause": "on",
        "useForOf": "on",
        "useShorthandAssign": "on",
        "useTemplate": "on"
      },
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "fix": "safe",
          "options": {
            "functions": ["cn", "clsx", "cva"]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**"],
      "linter": {
        "domains": {
          "react": "all",
          "next": "all"
        },
        "rules": {
          "correctness": {
            "useExhaustiveDependencies": "error",
            "useHookAtTopLevel": "error",
            "useUniqueElementIds": "off"
          },
          "suspicious": {
            "noLeakedRender": "error",
            "noReactForwardRef": "error"
          },
          "style": {
            "useFragmentSyntax": "on",
            "useComponentExportOnlyModules": "off"
          },
          "performance": {
            "noJsxPropsBind": "off"
          },
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/cli/**", "scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "complexity": {
            "noUselessUndefined": "off",
            "noUselessReturn": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "scripts/**",
        "packages/cli/src/render.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ]
}
